@model Mission6_Richards.Models.Movie

<h1>Enter Movie</h1>
<form method="post" asp-controller="Home" asp-action="@(Model?.MovieId > 0 ? "Edit" : "EnterMovie")"> <!-- if MovieId is >0, use edit method. Otherwise it should add record-->
    <!-- hidden field for editing -->
    @* Only include hidden MovieId when editing *@
    @if (Model?.MovieId > 0)
    {
        <input type="hidden" asp-for="MovieId" />
    }
    <label asp-for="CategoryId">Category</label>
    <select asp-for="CategoryId">
        <option value="">Select a Category</option>
        @foreach (var category in ViewBag.Categories)
        {
            <option value="@category.CategoryId">@category.CategoryName</option>
        }
    </select>
    <br />
    <label asp-for="Title">Title</label>
    <input asp-for="Title" />
    <br />
    <label asp-for="Year">Year</label>
    <input asp-for="Year" />
    <br />
    <label asp-for="Director">Director</label>
    <input asp-for="Director" />
    <br />
    <label asp-for="Rating">Rating</label>
    <select asp-for="Rating">
        <option value="G">G</option>
        <option value="PG">PG</option>
        <option value="PG-13">PG-13</option>
        <option value="R">R</option>
    </select>
    <br />
    <label asp-for="Edited">Edited</label>
    <input type="checkbox" asp-for="Edited" />
    <br />
    <label asp-for="LentTo">Lent To</label>
    <input asp-for="LentTo" />
    <br />
    <label asp-for="CopiedToPlex">Copied to Plex</label>
    <input type="checkbox" asp-for="CopiedToPlex" />
    <br />
    <label asp-for="Notes">Notes</label>
    <input type="text" asp-for="Notes" maxlength="25" />
    <br />
    <button type="submit">Submit</button>
    <div asp-validation-summary="All"></div>
</form>